[Unit]
Description=IMAP INBOX Forwarder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# --- Adjust the paths below to match your environment ---
WorkingDirectory=/path/to/imapforward
ExecStart=/path/to/imapforward/venv/bin/python3 imapforward.py config.json
# --------------------------------------
Restart=always
RestartSec=5
RuntimeMaxSec=86400  # Restart daily as a safety net

# Security hardening (optional)
NoNewPrivileges=true
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=default.target
